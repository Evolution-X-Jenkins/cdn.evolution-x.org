# Copy this file to .env and fill in your R2 credentials

# Cloudflare R2 Configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY=your-r2-access-key-id  
R2_SECRET_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Example values:
# R2_ACCOUNT_ID=1234567890abcdef1234567890abcdef
# R2_ACCESS_KEY=a1b2c3d4e5f6789012345678901234567890abcd
# R2_SECRET_KEY=abcdef1234567890abcdef1234567890abcdef12345678901234567890abcdef12
# R2_BUCKET_NAME=my-downloads-bucket

# Push queue completion callback (optional)
# Set PUSH_SEND_UPDATE=true to call PUSH_UPDATE_URL when a queued push job completes.
PUSH_SEND_UPDATE=false
PUSH_UPDATE_URL=

# Discord failure notifications (optional)
# When set, failed push jobs send a Discord webhook message with the error details.
DISCORD_PUSH_FAILURE_WEBHOOK_URL=
# Optional display name/avatar for the webhook message
DISCORD_PUSH_FAILURE_WEBHOOK_USERNAME=Evolution X Push Worker
DISCORD_PUSH_FAILURE_WEBHOOK_AVATAR_URL=

# Legacy compatibility (optional)
# PUSH_READY_CALLBACK_URL=