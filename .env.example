# Copy this file to .env and fill in your Bunny credentials

# Bunny Storage Configuration
BUNNY_STORAGE_ZONE=your-storage-zone
BUNNY_STORAGE_ACCESS_KEY=your-storage-access-key
BUNNY_STORAGE_REGION=de
BUNNY_S3_ACCESS_KEY=your-s3-access-key
BUNNY_S3_SECRET_KEY=your-s3-secret-key
# Optional; defaults to https://<region>-s3.storage.bunnycdn.com
BUNNY_S3_ENDPOINT=
BUNNY_DOWNLOAD_BASE_URL=https://downloads.example.com
BUNNY_FALLBACK_DOMAINS=downloads-backup.example.com

# BackBlaze / B2 source configuration for the push worker
# Point this at the mounted or readable source root for releases.
BACKBLAZE_SOURCE_ROOT=/mnt/backblaze
BACKBLAZE_FETCH_ROOT=/var/www/cdn/data/cache/backblaze_fetch
PUSH_STAGING_ROOT=/var/www/cdn/data/cache/tmp_push

# Standard BackBlaze B2 / S3-style credentials. Either set these or the B2_* aliases.
BACKBLAZE_S3_ACCESS_KEY=
BACKBLAZE_S3_SECRET_KEY=
BACKBLAZE_S3_REGION=us-east-005
BACKBLAZE_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
BACKBLAZE_BUCKET_NAME=

# Optional B2 aliases supported by the app.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_REGION=us-east-005
B2_S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_BUCKET_NAME=

# Example values:
# BUNNY_STORAGE_ZONE=evolution-builds
# BUNNY_STORAGE_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BUNNY_STORAGE_REGION=de
# BUNNY_DOWNLOAD_BASE_URL=https://evo-dl.example.com

# Push queue completion callback (optional)
# Set PUSH_SEND_UPDATE=true to call PUSH_UPDATE_URL when a queued push job completes.
PUSH_SEND_UPDATE=false
PUSH_UPDATE_URL=

# Discord failure notifications (optional)
# When set, failed push jobs send a Discord webhook message with the error details.
DISCORD_PUSH_FAILURE_WEBHOOK_URL=
# Optional display name/avatar for the webhook message
DISCORD_PUSH_FAILURE_WEBHOOK_USERNAME=Evolution X Push Worker
DISCORD_PUSH_FAILURE_WEBHOOK_AVATAR_URL=

# Legacy compatibility (optional)
# PUSH_READY_CALLBACK_URL=