<?php
/**
 * Bunny-first configuration example
 */

require_once __DIR__ . '/../../vendor/autoload.php';

function load_env($file = '.env') {
    if (!file_exists($file)) {
        return;
    }

    $lines = file($file, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        if (strpos($line, '#') === 0 || strpos($line, '=') === false) {
            continue;
        }

        [$key, $value] = explode('=', $line, 2);
        $key = trim($key);
        $value = trim($value);

        if (!array_key_exists($key, $_SERVER) && !array_key_exists($key, $_ENV)) {
            putenv("$key=$value");
            $_ENV[$key] = $value;
        }
    }
}

load_env();

// Core paths
define('BASE_PATH', '/mnt/evolution-x');
define('PRE_RELEASE_PATH', '/mnt/pre-release');
define('SITE_TITLE', 'Bunny File Browser');

// Bunny storage configuration
define('BUNNY_STORAGE_ZONE', getenv('BUNNY_STORAGE_ZONE') ?: 'your-storage-zone');
define('BUNNY_STORAGE_ACCESS_KEY', getenv('BUNNY_STORAGE_ACCESS_KEY') ?: 'your-storage-access-key');
define('BUNNY_STORAGE_REGION', strtolower((string)(getenv('BUNNY_STORAGE_REGION') ?: 'de')));
define('BUNNY_DOWNLOAD_BASE_URL', trim((string)(getenv('BUNNY_DOWNLOAD_BASE_URL') ?: 'https://downloads.example.com')));
define('BUNNY_FALLBACK_DOMAINS', array_values(array_filter(array_map('trim', explode(',', (string)(getenv('BUNNY_FALLBACK_DOMAINS') ?: ''))), static function ($value) {
    return $value !== '';
})));
define('DOWNLOAD_URL_EXPIRY', 3600);

// Database configuration
define('DB_TYPE', getenv('DB_TYPE') ?: 'mysql');
define('DB_HOST', getenv('DB_HOST') ?: 'localhost');
define('DB_PORT', (int)(getenv('DB_PORT') ?: 3306));
define('DB_NAME', getenv('DB_NAME') ?: 'filebrowser');
define('DB_USER', getenv('DB_USER') ?: 'filebrowser');
define('DB_PASS', getenv('DB_PASS') ?: 'change-me');
define('DB_CHARSET', getenv('DB_CHARSET') ?: 'utf8mb4');

// Cache/log basics
define('LOGS_DIR', __DIR__ . '/../../logs');
define('CACHE_FILE_DIR', __DIR__ . '/../../data/cache');
define('CACHE_REDIS_ENABLED', true);
define('CACHE_REDIS_SOCKET', '/var/run/redis/redis.sock');
define('CACHE_REDIS_HOST', 'localhost');
define('CACHE_REDIS_PORT', 6379);
define('CACHE_REDIS_PASSWORD', '');
define('DOWNLOAD_STATS_CACHE_TTL', 120);

define('LISTING_HIDDEN_NAMES', ['.bash_history', '.cache', '.config']);
define('LISTING_MANIFEST_DIR', __DIR__ . '/../../data/manifests');
define('LISTING_MANIFEST_FILE', LISTING_MANIFEST_DIR . '/current.json');
define('LISTING_MANIFEST_STATUS_FILE', LISTING_MANIFEST_DIR . '/status.json');
define('LISTING_MANIFEST_ARCHIVE_DIR', LISTING_MANIFEST_DIR . '/archive');
define('LISTING_ENABLE_DB_FALLBACK', true);
define('LISTING_ENABLE_LIVE_SCAN_FALLBACK', true);
define('LISTING_MANIFEST_CACHE_TTL', 1800);
