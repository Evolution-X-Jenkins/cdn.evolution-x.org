// Security: Ensure we stay within the base path
function sanitize_path($path, $base_path) {
    if (empty($path)) {
        return realpath($base_path);
    }
    
    $real_base = realpath($base_path);
    $test_path = $base_path . '/' . $path;
    
    // Check if path exists
    if (!file_exists($test_path)) {
        return $real_base;
    }
    
    $real_path = realpath($test_path);
    
    // If path is outside base path, return base path
    if (!$real_path || strpos($real_path, $real_base) !== 0) {
        return $real_base;
    }
    
    return $real_path;
}

// Function to format file size
function format_size($bytes) {
    $units = array('B', 'KB', 'MB', 'GB', 'TB');
    $bytes = max($bytes, 0);
    $pow = floor(($bytes ? log($bytes) : 0) / log(1024));
    $pow = min($pow, count($units) - 1);
    $bytes /= pow(1024, $pow);
    return round($bytes, 2) . ' ' . $units[$pow];
}

// Generate breadcrumb navigation
function generate_breadcrumb($path) {
    $parts = array_filter(explode('/', $path));
    $breadcrumb = array();
    $current = '';
    
    // Add root
    $breadcrumb[] = array('name' => 'Home', 'path' => '/');
    
    // Add each part
    foreach ($parts as $part) {
        $current .= '/' . $part;
        $breadcrumb[] = array('name' => $part, 'path' => $current);
    }
    
    return $breadcrumb;
}

// Get file extension for icon
function get_file_icon($filename, $is_dir) {
    if ($is_dir) {
        return get_folder_icon();
    }
    
    $ext = strtolower(pathinfo($filename, PATHINFO_EXTENSION));
    
    switch ($ext) {
        case 'zip':
        case 'rar':
        case '7z':
        case 'tar':
        case 'gz':
            return get_archive_icon();
        case 'img':
        case 'iso':
        case 'dmg':
            return get_disc_icon();
        case 'apk':
            return get_apk_icon();
        case 'json':
        case 'xml':
        case 'yml':
        case 'yaml':
        case 'ini':
        case 'conf':
            return get_config_icon();
        case 'md':
        case 'txt':
        case 'log':
        case 'readme':
            return get_text_icon();
        case 'png':
        case 'jpg':
        case 'jpeg':
        case 'gif':
        case 'bmp':
        case 'svg':
        case 'webp':
            return get_image_icon();
        case 'mp4':
        case 'mkv':
        case 'avi':
        case 'mov':
        case 'wmv':
        case 'flv':
            return get_video_icon();
        case 'mp3':
        case 'flac':
        case 'wav':
        case 'ogg':
        case 'm4a':
            return get_audio_icon();
        case 'pdf':
            return get_pdf_icon();
        case 'doc':
        case 'docx':
        case 'odt':
            return get_document_icon();
        case 'xls':
        case 'xlsx':
        case 'ods':
        case 'csv':
            return get_spreadsheet_icon();
        case 'ppt':
        case 'pptx':
        case 'odp':
            return get_presentation_icon();
        case 'js':
        case 'ts':
        case 'jsx':
        case 'tsx':
            return get_javascript_icon();
        case 'py':
            return get_python_icon();
        case 'php':
            return get_php_icon();
        case 'html':
        case 'htm':
            return get_html_icon();
        case 'css':
        case 'scss':
        case 'sass':
        case 'less':
            return get_css_icon();
        default:
            return get_file_icon_default();
    }
}

