// Generate random user ID
function generate_user_id() {
    $characters = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    $user_id = '';
    for ($i = 0; $i < 24; $i++) {
        $user_id .= $characters[random_int(0, strlen($characters) - 1)];
    }
    return $user_id;
}

// Get or create user ID
function get_user_id() {
    if (isset($_COOKIE['user_id']) && strlen($_COOKIE['user_id']) === 24) {
        return $_COOKIE['user_id'];
    }
    
    $user_id = generate_user_id();
    setcookie('user_id', $user_id, time() + (365 * 24 * 60 * 60), '/', '', false, true); // 1 year, httpOnly
    return $user_id;
}

// Get client IP address
function get_client_ip() {
    if (!empty($_SERVER['HTTP_CLIENT_IP'])) {
        return $_SERVER['HTTP_CLIENT_IP'];
    } elseif (!empty($_SERVER['HTTP_X_FORWARDED_FOR'])) {
        return $_SERVER['HTTP_X_FORWARDED_FOR'];
    } elseif (!empty($_SERVER['HTTP_X_FORWARDED'])) {
        return $_SERVER['HTTP_X_FORWARDED'];
    } elseif (!empty($_SERVER['HTTP_FORWARDED_FOR'])) {
        return $_SERVER['HTTP_FORWARDED_FOR'];
    } elseif (!empty($_SERVER['HTTP_FORWARDED'])) {
        return $_SERVER['HTTP_FORWARDED'];
    } else {
        return $_SERVER['REMOTE_ADDR'];
    }
}

// R2 Utilities
function get_r2_endpoint($use_fallback_domain = false) {
    // Check if we should use a fallback domain (user preference from connectivity test)
    if ($use_fallback_domain && defined('FALLBACK_DOMAINS') && !empty(FALLBACK_DOMAINS)) {
        // Use first available fallback domain
        return 'https://' . FALLBACK_DOMAINS[0];
    }
    
    // Default to standard R2 endpoint using path-style
    return 'https://' . R2_ACCOUNT_ID . '.r2.cloudflarestorage.com'; 
}

function get_s3_client() {
    static $client = null;
    
    if ($client === null) {
        $client = new S3Client([
            'version' => 'latest',
            'region' => R2_REGION,
            'endpoint' => 'https://' . R2_ACCOUNT_ID . '.r2.cloudflarestorage.com',
            'credentials' => [
                'key' => R2_ACCESS_KEY,
                'secret' => R2_SECRET_KEY,
            ],
            'use_path_style_endpoint' => true,
        ]);
    }
    
    return $client;
}

function generate_presigned_url($object_key, $expiry_seconds = null, $use_fallback_domain = false) {
    if ($expiry_seconds === null) {
        $expiry_seconds = PRESIGNED_URL_EXPIRY;
    }
    
    // Clean object key (remove leading slash)
    $object_key = ltrim($object_key, '/');
    
    try {
        $s3Client = get_s3_client();
        
        $command = $s3Client->getCommand('GetObject', [
            'Bucket' => R2_BUCKET_NAME,
            'Key' => $object_key
        ]);
        
        $presignedUrl = $s3Client->createPresignedRequest($command, '+' . $expiry_seconds . ' seconds')->getUri();
        
        return (string) $presignedUrl;
        
    } catch (AwsException $e) {
        error_log('AWS SDK Error generating presigned URL: ' . $e->getMessage());
        
        // Fallback: return a simple direct URL
        $endpoint = get_r2_endpoint($use_fallback_domain);
        return $endpoint . '/' . R2_BUCKET_NAME . '/' . $object_key;
    }
}

function should_use_fallback_domain() {
    // Check user preference from download method detector
    // This would be set by the JavaScript connectivity test
    return isset($_COOKIE['download_method_preference']) && $_COOKIE['download_method_preference'] === 'fallback';
}

// Log user action
function log_action($action, $path = '') {
    // Ensure log directory exists
    $log_dir = dirname(LOG_FILE);
    if (!file_exists($log_dir)) {
        mkdir($log_dir, 0755, true);
    }
    
    $user_id = get_user_id();
    $ip_address = get_client_ip();
    $timestamp = date('Y-m-d H:i:s');
    $log_entry = "[{$timestamp}] [{$ip_address}] [{$user_id}] {$action}";
    
    if (!empty($path)) {
        $log_entry .= " - {$path}";
    }
    
    // Write to both file and error_log
    file_put_contents(LOG_FILE, $log_entry . "\n", FILE_APPEND | LOCK_EX);
    error_log($log_entry);
}

function format_file_size($bytes) {
    if ($bytes == 0) return '0 B';
    
    $units = ['B', 'KB', 'MB', 'GB', 'TB', 'PB'];
    $pow = min(floor(log($bytes) / log(1024)), count($units) - 1);
    
    return round($bytes / (1024 ** $pow), 2) . ' ' . $units[$pow];
}
?>